# Copy this file to `.env` and fill in real values:
#   cp server/.env.example server/.env
#
# `.env` is listed in .gitignore and must never be committed — it will hold
# real secrets in later phases (Supabase keys, Meta app secret).
# This `.env.example` file contains no secrets and IS committed, so it serves
# as the checklist of what needs configuring.

# --- Phase 1 -----------------------------------------------------------

# Port the server listens on locally.
# Do NOT set this in Railway — Railway assigns the port itself.
PORT=3000

# 'development' locally, 'production' in Railway.
NODE_ENV=development

# Websites allowed to call this API from a browser, comma-separated.
# Leave empty until phase 6, when we connect the React frontend.
# Example once the frontend exists:
#   CORS_ORIGINS=http://localhost:5173,https://app.yourdomain.com
CORS_ORIGINS=

# --- Phase 2 -----------------------------------------------------------

# Postgres connection string from Supabase.
# Supabase dashboard -> Settings -> Database -> Connection string,
# and choose the "Session pooler" tab (NOT "Direct connection").
#
# The session pooler works over IPv4, which Railway needs. The direct
# connection is IPv6-only unless you pay for the IPv4 add-on, and the
# symptom of getting this wrong is a confusing "ENETUNREACH" error.
#
# Replace [YOUR-PASSWORD] with your database password. If the password
# contains symbols like @ : / or #, they must be percent-encoded
# (@ becomes %40, # becomes %23) or the URL will be misread.
DATABASE_URL=postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Fallback only. Leave this alone unless connecting fails with
# "self-signed certificate in certificate chain".
# DATABASE_SSL_NO_VERIFY=true

# --- Later phases (listed here so you know what's coming) --------------
# Phase 3 (Meta OAuth):
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=
