# Copy this file to `.env` and fill in real values:
#   cp server/.env.example server/.env
#
# `.env` is listed in .gitignore and must never be committed — it will hold
# real secrets in later phases (Supabase keys, Meta app secret).
# This `.env.example` file contains no secrets and IS committed, so it serves
# as the checklist of what needs configuring.

# --- Phase 1 -----------------------------------------------------------

# Port the server listens on locally.
# Do NOT set this in Railway — Railway assigns the port itself.
PORT=3000

# 'development' locally, 'production' in Railway.
NODE_ENV=development

# Websites allowed to call this API from a browser, comma-separated.
# Leave empty until phase 6, when we connect the React frontend.
# Example once the frontend exists:
#   CORS_ORIGINS=http://localhost:5173,https://app.yourdomain.com
CORS_ORIGINS=

# --- Later phases (listed here so you know what's coming) --------------
# Phase 2 (Supabase database + storage):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Phase 3 (Meta OAuth):
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=
